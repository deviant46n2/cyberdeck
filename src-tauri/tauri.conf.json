{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cyberdeck",
  "version": "0.1.0",
  "identifier": "dev.deviant.cyberdeck",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "cyberdeck",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
